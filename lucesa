# REDIRECCIÓN HTTP -> HTTPS
server {
    listen 80;
    server_name testpaginaweb.shop www.testpaginaweb.shop;
    return 301 https://$server_name$request_uri;
}

# SERVER PRINCIPAL HTTPS
server {
    listen 443 ssl;
    server_name testpaginaweb.shop www.testpaginaweb.shop;

    root /var/www/html/Lucesa/dist;
    index index.html index.htm;

    # SSL Configuration
    ssl_certificate /etc/letsencrypt/live/testpaginaweb.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/testpaginaweb.shop/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Configuración para archivos estáticos (SPA)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # PROXY PARA API - CONFIGURACIÓN CORREGIDA
    location /api/ {
        # Redirigir al backend
        proxy_pass http://localhost:4004/api/;
        
        # Headers esenciales
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        
        # Configuración CORS
        add_header Access-Control-Allow-Origin "https://testpaginaweb.shop" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" always;
        add_header Access-Control-Allow-Credentials "true" always;
        
        # Manejar preflight OPTIONS
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin "https://testpaginaweb.shop";
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
            add_header Access-Control-Max-Age 86400;
            add_header Content-Length 0;
            return 204;
        }
    }

    # Configuración de caché para archivos estáticos
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Prevenir acceso a archivos ocultos
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Configuración de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Logs
    access_log /var/log/nginx/testpaginaweb.shop.access.log;
    error_log /var/log/nginx/testpaginaweb.shop.error.log;
}